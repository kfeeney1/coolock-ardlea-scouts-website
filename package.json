{
  "name": "coolock-ardlea-scouts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/write-build-metadata.mjs",
    "lint": "oxlint",
    "test": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "test:email-worker": "node --test email-worker/tests/*.test.js",
    "test:e2e": "npx playwright test",
    "check:playwright-suite": "node scripts/verify-playwright-suite.mjs",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "audit:source": "node scripts/report-source-complexity.mjs",
    "audit:event-gallery-access": "node scripts/audit-event-gallery-access.mjs",
    "backfill:parent-gallery-events": "node scripts/backfill-parent-gallery-events.mjs",
    "check:source-complexity": "node scripts/report-source-complexity.mjs --check",
    "check:production-env": "node scripts/check-production-env.mjs",
    "check:hosting-config": "node scripts/check-hosting-config.mjs",
    "check:firebase-deploy-config": "node scripts/check-firebase-deployment-config.mjs",
    "check:firestore-audit-coverage": "node scripts/check-firestore-audit-coverage.mjs",
    "check:rbac-matrix": "node scripts/check-rbac-matrix.mjs",
    "check:rbac-test-coverage": "node scripts/check-rbac-test-coverage.mjs",
    "check:workflow-permissions": "node scripts/check-workflow-permissions.mjs",
    "check:workflow-action-pinning": "node scripts/check-workflow-action-pinning.mjs",
    "check:workflow-production-credentials": "node scripts/check-workflow-production-credentials.mjs",
    "check:smoke-script": "node --check scripts/check-live-deployment.mjs",
    "check:seed-contract": "node scripts/verify-repo-seed-contract.mjs",
    "smoke:live": "node scripts/check-live-deployment.mjs",
    "quality": "npm run lint && npm test && npm run test:email-worker && npm run audit:production && npm run check:seed-contract && npm run check:playwright-suite && npm run check:source-complexity && npm run check:hosting-config && npm run check:firebase-deploy-config && npm run check:firestore-audit-coverage && npm run check:rbac-matrix && npm run check:rbac-test-coverage && npm run check:workflow-permissions && npm run check:workflow-action-pinning && npm run check:workflow-production-credentials && npm run check:smoke-script && npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "firebase": "^12.16.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~7.0.2",
    "vite": "^8.1.1"
  }
}
