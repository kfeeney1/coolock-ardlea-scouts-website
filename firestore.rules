rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data; }
    function parentProfile() { return get(/databases/$(database)/documents/parentAccounts/$(request.auth.uid)).data; }
    function isCanonicalLeaderProfile() {
      return profile().active == true
        && profile().role in ["leader", "admin", "super-admin"]
        && profile().sections is list
        && profile().sections.size() > 0
        && !profile().keys().hasAny(["section"]);
    }
    function isActiveLeader() {
      return signedIn()
        && exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid))
        && isCanonicalLeaderProfile();
    }
    function isSuperAdmin() { return isActiveLeader() && profile().role == "super-admin"; }
    function isAdmin() { return isActiveLeader() && profile().role in ["super-admin", "admin"]; }
    function isGroupLeader() {
      return isActiveLeader()
        && exists(/databases/$(database)/documents/organisationLeadership/$(request.auth.uid))
        && get(/databases/$(database)/documents/organisationLeadership/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/organisationLeadership/$(request.auth.uid)).data.scoutingRole in ["Group Leader", "Deputy Group Leader", "Deputy-Group-Leader", "Deputy GroupLead", "DGL"];
    }
    function isRoverSectionLeader() {
      let organisationPath = /databases/$(database)/documents/organisationLeadership/$(request.auth.uid);
      return isActiveLeader() && profileHasSection("Rovers")
        && exists(organisationPath)
        && get(organisationPath).data.active == true
        && get(organisationPath).data.scoutingRole == "Section Leader";
    }
    function canManageRoverMembership() { return isAdmin() || isGroupLeader() || isRoverSectionLeader(); }
    function joinSectionLeaderAppointmentAt(data, index, section) {
      return data.keys().hasAny(["appointments"])
        && data.appointments is list && data.appointments.size() > index
        && data.appointments[index] is map
        && data.appointments[index].get("active", true) == true
        && data.appointments[index].appointment == "Section Leader"
        && data.appointments[index].scope == section;
    }
    function hasJoinSectionLeaderAppointment(data, section) {
      return joinSectionLeaderAppointmentAt(data, 0, section) || joinSectionLeaderAppointmentAt(data, 1, section)
        || joinSectionLeaderAppointmentAt(data, 2, section) || joinSectionLeaderAppointmentAt(data, 3, section);
    }
    function isJoinSectionLeader(section) {
      let organisationPath = /databases/$(database)/documents/organisationLeadership/$(request.auth.uid);
      let leadership = get(organisationPath).data;
      return isActiveLeader()
        && exists(organisationPath)
        && leadership.active == true
        && ((leadership.scoutingRole == "Section Leader" && leadership.organisationSection == section)
          || hasJoinSectionLeaderAppointment(leadership, section));
    }
    function canManageJoinSection(section) {
      return isActiveLeader() && (isAdmin() || isGroupLeader() || isJoinSectionLeader(section));
    }
    function isEligibleAdultUid(uid) {
      return uid is string
        && exists(/databases/$(database)/documents/adminUsers/$(uid))
        && get(/databases/$(database)/documents/adminUsers/$(uid)).data.active == true
        && get(/databases/$(database)/documents/adminUsers/$(uid)).data.role == "leader";
    }
    function isApprovedParent() {
      return signedIn()
        && exists(/databases/$(database)/documents/parentAccounts/$(request.auth.uid))
        && parentProfile().status == "approved";
    }
    function canManagePolicies() { return isAdmin() || isGroupLeader(); }
    function canReadPolicyAudience(audience) {
      return audience == "public"
        || (audience == "authenticated" && (isActiveLeader() || isApprovedParent()))
        || (audience == "parent" && isApprovedParent())
        || (audience == "leader" && isActiveLeader())
        || (audience == "admin" && canManagePolicies());
    }

    function isGroupSecretary() {
      return isActiveLeader()
        && exists(/databases/$(database)/documents/organisationLeadership/$(request.auth.uid))
        && get(/databases/$(database)/documents/organisationLeadership/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/organisationLeadership/$(request.auth.uid)).data.scoutingRole == "Group Secretary";
    }
    function isGroupTreasurer() {
      return isActiveLeader()
        && exists(/databases/$(database)/documents/organisationLeadership/$(request.auth.uid))
        && get(/databases/$(database)/documents/organisationLeadership/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/organisationLeadership/$(request.auth.uid)).data.scoutingRole == "Group Treasurer";
    }
    function isQuartermaster() {
      return isActiveLeader()
        && exists(/databases/$(database)/documents/organisationLeadership/$(request.auth.uid))
        && get(/databases/$(database)/documents/organisationLeadership/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/organisationLeadership/$(request.auth.uid)).data.scoutingRole in ["Group Quartermaster", "Group Quartermaster/Bo'sun", "Group Quartermaster / Bo'sun", "Group Bo'sun"];
    }
    function canManageEquipment() { return isAdmin() || isGroupLeader() || isQuartermaster(); }
    function canViewAllFinance() {
      let organisationPath = /databases/$(database)/documents/organisationLeadership/$(request.auth.uid);
      return isActiveLeader()
        && (profile().role in ["super-admin", "admin"]
          || (exists(organisationPath)
            && get(organisationPath).data.active == true
            && (get(organisationPath).data.scoutingRole in ["Group Leader", "Deputy Group Leader", "Deputy-Group-Leader", "Deputy GroupLead", "DGL", "Group Treasurer"]
              || hasFinanceAppointment(get(organisationPath).data))));
    }
    // The same existing group-wide member readers, evaluated once rather than
    // repeating leader-profile validation across several independent role paths.
    function canReadAllMembers() {
      let organisationPath = /databases/$(database)/documents/organisationLeadership/$(request.auth.uid);
      let organisation = get(organisationPath).data;
      return isActiveLeader()
        && (profile().role in ["super-admin", "admin"]
          || (exists(organisationPath) && organisation.active == true
            && (organisation.scoutingRole in ["Group Secretary", "Group Leader", "Deputy Group Leader", "Deputy-Group-Leader", "Deputy GroupLead", "DGL", "Group Treasurer"]
              || hasFinanceAppointment(organisation))));
    }
    function financeAppointmentAt(data, index) {
      return data.keys().hasAny(["appointments"])
        && data.appointments is list && data.appointments.size() > index
        && data.appointments[index] is map
        && data.appointments[index].get("active", true) == true
        && data.appointments[index].appointment in ["Group Leader", "Deputy Group Leader", "Group Treasurer"];
    }
    function hasFinanceAppointment(data) {
      return financeAppointmentAt(data, 0) || financeAppointmentAt(data, 1)
        || financeAppointmentAt(data, 2) || financeAppointmentAt(data, 3);
    }
    function canManageSubsPolicy() { return canViewAllFinance(); }
    function isOrdinaryLeaderTarget(userId) {
      return exists(/databases/$(database)/documents/adminUsers/$(userId))
        && get(/databases/$(database)/documents/adminUsers/$(userId)).data.role == "leader";
    }
    function isGroupLeadershipDelegableAppointment(value) {
      return value in ["Group Chairperson", "Group Youth Champion", "Section Leader", "Assistant Section Leader", "Programme Scouter", "Scouter"];
    }
    function canDelegateLeaderTarget(userId) {
      return isGroupLeader() && request.auth.uid != userId && isOrdinaryLeaderTarget(userId);
    }
    function profileHasSection(section) {
      return section in profile().sections
        || (section in ["Beaver", "Beaver Scout", "Beaver Scouts"] && "Beavers" in profile().sections)
        || (section in ["Cub", "Cub Scout", "Cub Scouts"] && "Cubs" in profile().sections)
        || (section == "Scout" && "Scouts" in profile().sections)
        || (section in ["Venture", "Venture Scout", "Venture Scouts"] && "Ventures" in profile().sections)
        || (section in ["Rover", "Rover Scout", "Rover Scouts"] && "Rovers" in profile().sections);
    }
    function hasSection(section) {
      return isAdmin() || (isActiveLeader() && profileHasSection(section));
    }
    function memberHasSection(data, section) {
      return (data.keys().hasAny(["sections"]) && data.sections is list && section in data.sections)
        || (data.keys().hasAny(["section"]) && data.section == section);
    }
    // Call only after isActiveLeader() has been established by the enclosing rule.
    // Keeping this helper to section-overlap checks avoids repeatedly expanding the
    // authentication/profile predicates and hitting Firestore's expression limit.
    function canAccessMemberSections(data) {
      return profile().role in ["super-admin", "admin"]
        || (data.keys().hasAny(["section"]) && profileHasSection(data.section))
        || (data.keys().hasAny(["sections"]) && data.sections is list && data.sections.hasAny(profile().sections));
    }
    function isSelfManagedRoverMember() {
      return isActiveLeader()
        && request.auth.token.email is string
        && resource.data.emailAddress == request.auth.token.email
        && request.resource.data.emailAddress == request.auth.token.email
        && (!resource.data.keys().hasAny(["accountUid"]) || resource.data.accountUid == request.auth.uid)
        && request.resource.data.accountUid == request.auth.uid
        && request.resource.data.firstName == resource.data.firstName
        && request.resource.data.lastName == resource.data.lastName
        && request.resource.data.sections is list
        && request.resource.data.sections.size() > 0
        && request.resource.data.section in request.resource.data.sections
        && request.resource.data.status in ["active", "inactive", "left"]
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["accountUid", "section", "sections", "sectionRoles", "status", "updatedAt", "updatedBy"])
        && ((request.resource.data.sections.hasAny(["Rovers"])
            && (!resource.data.keys().hasAny(["sections"]) || request.resource.data.sections.hasAll(resource.data.sections)))
          || (!request.resource.data.sections.hasAny(["Rovers"])
            && resource.data.sections is list
            && resource.data.sections.hasAny(["Rovers"])
            && resource.data.sections.hasAll(request.resource.data.sections))
          || (request.resource.data.status == "left"
            && request.resource.data.sections == ["Rovers"]
            && memberHasSection(resource.data, "Rovers")));
    }
    function isManagedRoverMemberChange() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(["roverManagementAt"])
        && request.resource.data.roverManagementAt == request.time
        && canManageRoverMembership()
        && request.resource.data.accountUid is string
        && (!resource.data.keys().hasAny(["accountUid"]) || resource.data.accountUid == request.resource.data.accountUid)
        && request.resource.data.sections is list
        && request.resource.data.sections.size() > 0
        && request.resource.data.sections.hasOnly(["Beavers", "Cubs", "Scouts", "Ventures", "Rovers"])
        && request.resource.data.section in request.resource.data.sections
        && request.resource.data.status in ["active", "inactive", "left"]
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["accountUid", "section", "sections", "sectionRoles", "status", "updatedAt", "updatedBy", "roverManagementAt"])
        && ((request.resource.data.sections.hasAny(["Rovers"])
              && (!resource.data.keys().hasAny(["sections"]) || request.resource.data.sections.hasAll(resource.data.sections)))
          || (!request.resource.data.sections.hasAny(["Rovers"])
              && resource.data.sections is list && resource.data.sections.hasAny(["Rovers"])
              && resource.data.sections.hasAll(request.resource.data.sections))
          || (request.resource.data.status == "left" && request.resource.data.sections == ["Rovers"] && memberHasSection(resource.data, "Rovers")));
    }
    function isYouthSection(section) {
      return section in ["Beavers", "Cubs", "Scouts", "Ventures", "Rovers"];
    }
    // Call only after isActiveLeader() has been established by the enclosing rule.
    // Source authority is sufficient for a youth-section transfer; destination
    // authority is deliberately not required and no profile permissions are changed.
    function canTransferMember(fromSection, toSection) {
      return (profile().role in ["super-admin", "admin"] || profileHasSection(fromSection))
        && isYouthSection(fromSection) && isYouthSection(toSection);
    }
    function canAccessFinanceSection(section) {
      return isActiveLeader() && section is string && ((section in profile().sections) || canViewAllFinance());
    }
    function hasResourceSection(data) {
      return data.keys().hasAny(["section"]) && data.section is string && hasSection(data.section);
    }
    function isApprovedParentForMember(memberId) {
      return signedIn() && exists(/databases/$(database)/documents/parentAccounts/$(request.auth.uid))
        && parentProfile().status == "approved"
        && parentProfile().memberIds is list
        && memberId in parentProfile().memberIds;
    }
    function parentMemberCurrentlyInSection(memberId, section) {
      return memberId is string
        && exists(/databases/$(database)/documents/members/$(memberId))
        && get(/databases/$(database)/documents/members/$(memberId)).data.status == "active"
        && memberHasSection(get(/databases/$(database)/documents/members/$(memberId)).data, section);
    }
    function isApprovedParentForSection(section) {
      return isApprovedParent()
        && parentProfile().memberIds is list
        && parentProfile().memberIds.size() <= 8
        && (
          section in ["Group", "All Sections"]
          || (parentProfile().memberIds.size() > 0 && parentMemberCurrentlyInSection(parentProfile().memberIds[0], section))
          || (parentProfile().memberIds.size() > 1 && parentMemberCurrentlyInSection(parentProfile().memberIds[1], section))
          || (parentProfile().memberIds.size() > 2 && parentMemberCurrentlyInSection(parentProfile().memberIds[2], section))
          || (parentProfile().memberIds.size() > 3 && parentMemberCurrentlyInSection(parentProfile().memberIds[3], section))
          || (parentProfile().memberIds.size() > 4 && parentMemberCurrentlyInSection(parentProfile().memberIds[4], section))
          || (parentProfile().memberIds.size() > 5 && parentMemberCurrentlyInSection(parentProfile().memberIds[5], section))
          || (parentProfile().memberIds.size() > 6 && parentMemberCurrentlyInSection(parentProfile().memberIds[6], section))
          || (parentProfile().memberIds.size() > 7 && parentMemberCurrentlyInSection(parentProfile().memberIds[7], section))
        );
    }

    function isApprovedParentForAudienceMembers(memberIds) {
      return isApprovedParent()
        && memberIds is list
        && parentProfile().memberIds is list
        && parentProfile().memberIds.size() <= 8
        && memberIds.hasAny(parentProfile().memberIds);
    }

    function isActiveMember(memberId) {
      return memberId is string
        && exists(/databases/$(database)/documents/members/$(memberId))
        && get(/databases/$(database)/documents/members/$(memberId)).data.status == "active";
    }

    function parentHasEventAudienceMemberAt(eventId, index) {
      return isApprovedParent()
        && parentProfile().memberIds is list
        && parentProfile().memberIds.size() > index
        && parentProfile().memberIds[index] is string
        && isActiveMember(parentProfile().memberIds[index])
        && exists(/databases/$(database)/documents/events/$(eventId)/audienceMembers/$(parentProfile().memberIds[index]))
        && get(/databases/$(database)/documents/events/$(eventId)/audienceMembers/$(parentProfile().memberIds[index])).data.memberId == parentProfile().memberIds[index];
    }

    function isApprovedParentForEventRecord(eventId) {
      return parentHasEventAudienceMemberAt(eventId, 0) || parentHasEventAudienceMemberAt(eventId, 1)
        || parentHasEventAudienceMemberAt(eventId, 2) || parentHasEventAudienceMemberAt(eventId, 3)
        || parentHasEventAudienceMemberAt(eventId, 4) || parentHasEventAudienceMemberAt(eventId, 5)
        || parentHasEventAudienceMemberAt(eventId, 6) || parentHasEventAudienceMemberAt(eventId, 7);
    }

    function validVersion3EventAudience(data) {
      return !data.keys().hasAny(["audience"])
        || (data.audience is map
          && data.audience.version == 3
          && data.audience.mode in ["sections", "members", "mixed"]
          && data.audience.semantics == "snapshot"
          && data.audience.sectionIds is list
          && data.audience.sectionIds.hasOnly(["Beavers", "Cubs", "Scouts", "Ventures", "Rovers"])
          && (isAdmin() || data.audience.sectionIds.hasOnly(profile().sections))
          && data.audience.memberIds is list && data.audience.memberIds.size() == 0
          && data.audience.resolvedMemberIds is list && data.audience.resolvedMemberIds.size() == 0);
    }

    function validEventAudienceMembership(eventId, memberId) {
      let eventPath = /databases/$(database)/documents/events/$(eventId);
      let memberPath = /databases/$(database)/documents/members/$(memberId);
      let eventData = getAfter(eventPath).data;
      let memberData = get(memberPath).data;
      return isActiveLeader()
        && existsAfter(eventPath)
        && eventData.audience is map && eventData.audience.version == 3
        && hasSection(eventData.section)
        && request.resource.data.eventId == eventId
        && request.resource.data.eventSection == eventData.section
        && request.resource.data.memberId == memberId
        && request.resource.data.scopeSection is string
        && (isAdmin() || profileHasSection(request.resource.data.scopeSection))
        && exists(memberPath) && memberData.status == "active"
        && memberHasSection(memberData, request.resource.data.scopeSection)
        && request.resource.data.selectedBySection is bool
        && request.resource.data.selectedIndividually is bool
        && (request.resource.data.selectedBySection || request.resource.data.selectedIndividually)
        && (!request.resource.data.selectedBySection || request.resource.data.scopeSection in eventData.audience.sectionIds)
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly(["eventId", "eventSection", "memberId", "scopeSection", "selectedBySection", "selectedIndividually", "updatedAt", "updatedBy"]);
    }

    function isCanonicalAdventureSkillStage(skillId, stage) {
      return skillId in ["air-activities", "backwoods", "camping", "emergencies", "hillwalking", "paddling", "pioneering", "rowing", "sailing", "swimming"]
        && stage is number
        && stage >= 1
        && ((skillId == "swimming" && stage <= 6) || (skillId != "swimming" && stage <= 9));
    }
    function isCanonicalAdventureSkillAwardId(awardId, skillId, stage) {
      return (stage == 1 && awardId == skillId + "-stage-1")
        || (stage == 2 && awardId == skillId + "-stage-2")
        || (stage == 3 && awardId == skillId + "-stage-3")
        || (stage == 4 && awardId == skillId + "-stage-4")
        || (stage == 5 && awardId == skillId + "-stage-5")
        || (stage == 6 && awardId == skillId + "-stage-6")
        || (stage == 7 && awardId == skillId + "-stage-7")
        || (stage == 8 && awardId == skillId + "-stage-8")
        || (stage == 9 && awardId == skillId + "-stage-9");
    }

    match /policyDocuments/{documentId} {
      allow get, list: if resource.data.state == "current" && canReadPolicyAudience(resource.data.audience);
      allow create, update: if canManagePolicies()
        && request.resource.data.documentId == documentId
        && request.resource.data.versionId is string
        && request.resource.data.title is string
        && request.resource.data.description is string
        && request.resource.data.category is string
        && request.resource.data.audience in ["public", "authenticated", "parent", "leader", "admin"]
        && request.resource.data.effectiveDate is string
        && request.resource.data.sourceOwner is string
        && request.resource.data.storagePath is string
        && request.resource.data.fileName is string
        && request.resource.data.contentType == "application/pdf"
        && request.resource.data.size is number
        && request.resource.data.size > 0
        && request.resource.data.size <= 10 * 1024 * 1024
        && request.resource.data.publishedBy == request.auth.uid
        && request.resource.data.previousVersions is list
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && ((request.resource.data.state == "current" && request.resource.data.publishedAt == request.time)
          || (resource != null
            && resource.data.state == "current"
            && request.resource.data.state == "withdrawn"
            && request.resource.data.withdrawnBy == request.auth.uid
            && request.resource.data.withdrawnAt == request.time));
      allow delete: if false;
    }

    match /consentReminderDeliveries/{reminderId} {
      // Trusted communications infrastructure writes reminder lifecycle evidence
      // with a service account. Clients cannot read or forge delivery history.
      allow read, write: if false;
    }

    match /adminUsers/{userId} {
      allow get: if isActiveLeader();
      allow list: if isAdmin() || isGroupLeader() || (isRoverSectionLeader() && resource.data.active == true && resource.data.role == "leader");
      allow create: if isAdmin()
        && request.resource.data.role == "leader"
        && request.resource.data.active == true
        && request.resource.data.displayName is string
        && request.resource.data.email is string
        && request.resource.data.sections is list
        && request.resource.data.sections.size() > 0
        && !request.resource.data.keys().hasAny(["section"]);
      allow update: if (request.auth.uid == userId && isActiveLeader()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["displayName", "mobileNumber"]))
        || (request.auth.uid == userId && isSuperAdmin()
          && request.resource.data.uiTheme in ["default", "modern", "irish-adventure", "uk-campaign", "programme-led"]
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["uiTheme"]))
        || ((isAdmin() || canDelegateLeaderTarget(userId)) && resource.data.role == "leader"
          && request.resource.data.role == "leader"
          && request.resource.data.sections is list
          && request.resource.data.sections.size() > 0
          && !request.resource.data.keys().hasAny(["section"])
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(isAdmin() ? ["active", "sections", "displayName", "mobileNumber", "updatedAt", "updatedBy"] : ["sections", "updatedAt", "updatedBy"]))
        || (isSuperAdmin() && resource.data.role != "super-admin"
          && request.resource.data.role in ["leader", "admin"]
          && request.resource.data.sections is list
          && request.resource.data.sections.size() > 0
          && !request.resource.data.keys().hasAny(["section"])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["active", "role", "sections", "displayName", "mobileNumber", "updatedAt", "updatedBy"]));
      allow delete: if false;
    }

    match /leaderChildRelationships/{relationshipId} {
      allow get, list: if isAdmin() || isGroupLeader() || canViewAllFinance();
      allow create: if (isAdmin() || isGroupLeader())
        && request.resource.data.leaderUid is string
        && request.resource.data.memberId is string
        && relationshipId == request.resource.data.leaderUid + "--" + request.resource.data.memberId
        && request.resource.data.active is bool
        && exists(/databases/$(database)/documents/adminUsers/$(request.resource.data.leaderUid))
        && get(/databases/$(database)/documents/adminUsers/$(request.resource.data.leaderUid)).data.active == true
        && get(/databases/$(database)/documents/adminUsers/$(request.resource.data.leaderUid)).data.role == "leader"
        && exists(/databases/$(database)/documents/members/$(request.resource.data.memberId))
        && get(/databases/$(database)/documents/members/$(request.resource.data.memberId)).data.status == "active"
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly(["leaderUid", "memberId", "active", "createdBy", "createdAt", "updatedBy", "updatedAt"]);
      allow update: if (isAdmin() || isGroupLeader())
        && request.resource.data.active is bool
        && request.resource.data.leaderUid == resource.data.leaderUid
        && request.resource.data.memberId == resource.data.memberId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["active", "updatedBy", "updatedAt"]);
      allow delete: if false;
    }

    match /parentAccounts/{userId} {
      allow create: if signedIn() && request.auth.uid == userId && request.resource.data.uid == userId
        && request.resource.data.status == "pending" && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() == 0 && request.resource.data.linkedSections is list
        && request.resource.data.linkedSections.size() == 0;
      allow get: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow list: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "memberIds", "linkedSections", "reviewedBy", "reviewedAt", "updatedAt"])
        && (request.resource.data.status != "approved" || (request.resource.data.memberIds is list && request.resource.data.memberIds.size() > 0));
      allow delete: if false;
    }

