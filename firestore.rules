          && data.keys().hasOnly(["completedDate", "expiryDate", "showOnCalendar", "revision", "updatedBy", "updatedAt"])
          && data.get("showOnCalendar", false) is bool
          && (!data.get("showOnCalendar", false) || data.expiryDate != "")
          && (data.completedDate == "" || validIsoDate(data.completedDate))
          && (data.expiryDate == "" || validIsoDate(data.expiryDate))
