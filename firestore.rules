    }
    // Weekly meeting rosters are capped at 100 persisted entries. Check the persisted
    // attendance record itself; a client-supplied badgework member list is not authority.
    function isYouthSection(section) {
      return section in ["Beavers", "Cubs", "Scouts", "Ventures", "Rovers"];
    }
    // Call only after isActiveLeader() has been established by the enclosing rule.
    // Source authority is sufficient for a youth-section transfer; destination
