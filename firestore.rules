rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function matchesCalendarDate(value) {
      let parts = value.split('-');
      let year = int(parts[0]);
      let month = int(parts[1]);
      let day = int(parts[2]);
      let date = timestamp.date(year, month, day);
      return date.year() == year && date.month() == month && date.day() == day;
    }
    function validIsoDate(value) {
      return value is string
        && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && matchesCalendarDate(value);
    }
    function validDateRange(startDate, endDate) {
      return validIsoDate(startDate) && validIsoDate(endDate)
        && startDate <= endDate;
    }
    function profile() { return get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data; }
    function parentProfile() { return get(/databases/$(database)/documents/parentAccounts/$(request.auth.uid)).data; }
    function isCanonicalLeaderProfile() {
      let data = profile();
      return data.active == true
        && data.role in ["leader", "admin", "super-admin"]
        && data.sections is list
        && data.sections.size() > 0
        && !data.keys().hasAny(["section"]);
    }
    function isActiveLeader() {
      return signedIn()
        && exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid))
        && isCanonicalLeaderProfile();
    }
    function isSuperAdmin() { return isActiveLeader() && profile().role == "super-admin"; }
    function isAdmin() { return isActiveLeader() && profile().role in ["super-admin", "admin"]; }
    function activeGroupLeadership(data) {
      return data.active == true
        && data.scoutingRole in ["Group Leader", "Deputy Group Leader", "Deputy-Group-Leader", "Deputy GroupLead", "DGL"];
    }
    function isGroupLeader() {
      return isActiveLeader()
        && exists(/databases/$(database)/documents/organisationLeadership/$(request.auth.uid))
        && activeGroupLeadership(get(/databases/$(database)/documents/organisationLeadership/$(request.auth.uid)).data);
    }
    function joinSectionLeaderAppointmentAt(data, index, section) {
      return data.keys().hasAny(["appointments"])
        && data.appointments is list && data.appointments.size() > index
        && data.appointments[index] is map
        && data.appointments[index].get("active", true) == true
        && data.appointments[index].appointment == "Section Leader"
        && data.appointments[index].scope == section;
    }
    function hasJoinSectionLeaderAppointment(data, section) {
      return joinSectionLeaderAppointmentAt(data, 0, section) || joinSectionLeaderAppointmentAt(data, 1, section)
        || joinSectionLeaderAppointmentAt(data, 2, section) || joinSectionLeaderAppointmentAt(data, 3, section);
    }
    function isRoverSectionLeader() {
      let organisationPath = /databases/$(database)/documents/organisationLeadership/$(request.auth.uid);
      let leadership = get(organisationPath).data;
      return isActiveLeader() && profileHasSection("Rovers")
        && exists(organisationPath)
        && leadership.active == true
        && ((leadership.scoutingRole == "Section Leader" && leadership.organisationSection == "Rovers")
          || hasJoinSectionLeaderAppointment(leadership, "Rovers"));
    }
    function isActiveRegisteredLeader(uid) {
      return uid is string
        && exists(/databases/$(database)/documents/adminUsers/$(uid))
        && get(/databases/$(database)/documents/adminUsers/$(uid)).data.active == true
        && get(/databases/$(database)/documents/adminUsers/$(uid)).data.role == "leader"
        && exists(/databases/$(database)/documents/organisationLeadership/$(uid))
        && get(/databases/$(database)/documents/organisationLeadership/$(uid)).data.active == true;
    }
    function validLeaderAttendanceRecord(uid) {
      return isActiveRegisteredLeader(uid)
        && request.resource.data.displayName == get(/databases/$(database)/documents/organisationLeadership/$(uid)).data.displayName
        && request.resource.data.appointments is list
        && request.resource.data.appointments.size() <= 12
        && request.resource.data.sections is list
        && request.resource.data.sections.size() <= 6
        && request.resource.data.attendance in ["unrecorded", "present", "absent"]
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly(["displayName", "appointments", "sections", "attendance", "updatedBy", "updatedAt"]);
    }
    function isApprovedParent() {
      return signedIn()
        && exists(/databases/$(database)/documents/parentAccounts/$(request.auth.uid))
        && parentProfile().status == "approved";
    }

    function isGroupSecretary() {
      return isActiveLeader()
        && exists(/databases/$(database)/documents/organisationLeadership/$(request.auth.uid))
        && get(/databases/$(database)/documents/organisationLeadership/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/organisationLeadership/$(request.auth.uid)).data.scoutingRole == "Group Secretary";
    }

    function isQuartermaster() {
      return isActiveLeader()
        && exists(/databases/$(database)/documents/organisationLeadership/$(request.auth.uid))
        && get(/databases/$(database)/documents/organisationLeadership/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/organisationLeadership/$(request.auth.uid)).data.scoutingRole in ["Group Quartermaster", "Group Quartermaster/Bo'sun", "Group Quartermaster / Bo'sun", "Group Bo'sun"];
    }
    function canManageEquipment() { return isAdmin() || isGroupLeader() || isQuartermaster(); }
    function canViewAllFinance() {
      let organisationPath = /databases/$(database)/documents/organisationLeadership/$(request.auth.uid);
      return isActiveLeader()
        && (profile().role in ["super-admin", "admin"]
          || (exists(organisationPath)
            && get(organisationPath).data.active == true
            && (get(organisationPath).data.scoutingRole in ["Group Leader", "Deputy Group Leader", "Deputy-Group-Leader", "Deputy GroupLead", "DGL", "Group Treasurer"]
              || hasFinanceAppointment(get(organisationPath).data))));
    }
    // The same existing group-wide member readers, evaluated once rather than
    // repeating leader-profile validation across several independent role paths.
    function financeAppointmentAt(data, index) {
      return data.keys().hasAny(["appointments"])
        && data.appointments is list && data.appointments.size() > index
        && data.appointments[index] is map
        && data.appointments[index].get("active", true) == true
        && data.appointments[index].appointment in ["Group Leader", "Deputy Group Leader", "Group Treasurer"];
    }
    function hasFinanceAppointment(data) {
      return financeAppointmentAt(data, 0) || financeAppointmentAt(data, 1)
        || financeAppointmentAt(data, 2) || financeAppointmentAt(data, 3);
    }
    function canManageSubsPolicy() { return canViewAllFinance(); }
    function isOrdinaryLeaderTarget(userId) {
      return exists(/databases/$(database)/documents/adminUsers/$(userId))
        && get(/databases/$(database)/documents/adminUsers/$(userId)).data.role == "leader";
    }
    function isGroupLeadershipDelegableAppointment(value) {
      return value in ["Group Chairperson", "Group Youth Champion", "Section Leader", "Assistant Section Leader", "Programme Scouter", "Scouter"];
    }
    function canDelegateLeaderTarget(userId) {
      return isGroupLeader() && request.auth.uid != userId && isOrdinaryLeaderTarget(userId);
    }
    function profileHasSection(section) {
      let sections = profile().sections;
      return section in sections
        || (section in ["Beaver", "Beaver Scout", "Beaver Scouts"] && "Beavers" in sections)
        || (section in ["Cub", "Cub Scout", "Cub Scouts"] && "Cubs" in sections)
        || (section == "Scout" && "Scouts" in sections)
        || (section in ["Venture", "Venture Scout", "Venture Scouts"] && "Ventures" in sections)
        || (section in ["Rover", "Rover Scout", "Rover Scouts"] && "Rovers" in sections);
    }
