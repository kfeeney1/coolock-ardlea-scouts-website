      function _validateWrite0(_writeData) {
        return canManagePolicies()
        && _writeData.documentId == documentId
        && _writeData.versionId is string
        && _writeData.title is string
        && _writeData.description is string
        && _writeData.category is string
        && _writeData.audience in ["public", "authenticated", "parent", "leader", "admin"]
