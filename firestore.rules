          || (parentProfile().memberIds.size() > 1 && parentMemberCurrentlyInSection(parentProfile().memberIds[1], section))
          || (parentProfile().memberIds.size() > 2 && parentMemberCurrentlyInSection(parentProfile().memberIds[2], section))
          || (parentProfile().memberIds.size() > 3 && parentMemberCurrentlyInSection(parentProfile().memberIds[3], section))
