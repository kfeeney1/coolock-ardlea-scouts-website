        || (data.keys().hasAny(["section"]) && profileHasSection(data.section))
        || (data.keys().hasAny(["sections"]) && data.sections is list && data.sections.hasAny(profile().sections));
    }
    // Keep the fixed appointment lookup bounded; Firestore Rules caps each evaluation at 1,000 expressions.
    function eventSectionAppointmentMatches(appointment, sectionAliases) {
      return appointment is map
        && appointment.get("active", true) == true
        && appointment.get("appointment", "") in ["Section Leader", "Assistant Section Leader", "Programme Scouter", "Scouter"]
        && appointment.get("scope", "") in sectionAliases;
    }
    function eventSectionAppointmentAt(data, index, sectionAliases) {
      return data.appointments.size() > index
        && eventSectionAppointmentMatches(data.appointments[index], sectionAliases);
    }
    function hasEventSectionAppointment(section) {
      let organisationPath = /databases/$(database)/documents/organisationLeadership/$(request.auth.uid);
      let leadership = get(organisationPath).data;
      let aliases = badgeworkSectionAliases(section);
      return exists(organisationPath) && leadership.active == true
        && ((!leadership.keys().hasAny(["appointments"])
              || !(leadership.appointments is list) || leadership.appointments.size() == 0)
          ? leadership.scoutingRole in ["Section Leader", "Assistant Section Leader", "Programme Scouter", "Scouter"]
            && leadership.organisationSection in aliases
          : leadership.appointments is list && (eventSectionAppointmentAt(leadership, 0, aliases)
            || eventSectionAppointmentAt(leadership, 1, aliases)
            || eventSectionAppointmentAt(leadership, 2, aliases)
            || eventSectionAppointmentAt(leadership, 3, aliases)
            || eventSectionAppointmentAt(leadership, 4, aliases)
            || eventSectionAppointmentAt(leadership, 5, aliases)
            || eventSectionAppointmentAt(leadership, 6, aliases)
            || eventSectionAppointmentAt(leadership, 7, aliases)
            || eventSectionAppointmentAt(leadership, 8, aliases)
            || eventSectionAppointmentAt(leadership, 9, aliases)
            || eventSectionAppointmentAt(leadership, 10, aliases)
            || eventSectionAppointmentAt(leadership, 11, aliases)));
    }
    function canAccessEventSection(section) {
      // Every caller enforces active-leader access before this scoped check.
