rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data; }
    function parentProfile() { return get(/databases/$(database)/documents/parentAccounts/$(request.auth.uid)).data; }
    function isCanonicalLeaderProfile() {
      return profile().active == true
        && profile().role in ["leader", "admin", "super-admin"]
        && profile().sections is list
        && profile().sections.size() > 0
        && !profile().keys().hasAny(["section"]);
    }
    function isActiveLeader() {
      return signedIn()
        && exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid))
        && isCanonicalLeaderProfile();
    }
    function isSuperAdmin() { return isActiveLeader() && profile().role == "super-admin"; }
    function isAdmin() { return isActiveLeader() && profile().role in ["super-admin", "admin"]; }
    function isGroupLeader() {
      return isActiveLeader()
        && exists(/databases/$(database)/documents/organisationLeadership/$(request.auth.uid))
        && get(/databases/$(database)/documents/organisationLeadership/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/organisationLeadership/$(request.auth.uid)).data.scoutingRole == "Group Leader";
    }
    function isGroupSecretary() {
      return isActiveLeader()
        && exists(/databases/$(database)/documents/organisationLeadership/$(request.auth.uid))
        && get(/databases/$(database)/documents/organisationLeadership/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/organisationLeadership/$(request.auth.uid)).data.scoutingRole == "Group Secretary";
    }
    function hasSection(section) {
      return isAdmin() || (isActiveLeader() && section in profile().sections);
    }
    function hasResourceSection(data) {
      return data.keys().hasAny(["section"]) && data.section is string && hasSection(data.section);
    }
    function isApprovedParentForMember(memberId) {
      return signedIn() && exists(/databases/$(database)/documents/parentAccounts/$(request.auth.uid))
        && parentProfile().status == "approved"
        && parentProfile().memberIds is list
        && memberId in parentProfile().memberIds;
    }
    function isApprovedParentForSection(section) {
      return signedIn() && exists(/databases/$(database)/documents/parentAccounts/$(request.auth.uid))
        && parentProfile().status == "approved"
        && parentProfile().linkedSections is list
        && section in parentProfile().linkedSections;
    }

    match /adminUsers/{userId} {
      allow get: if isActiveLeader();
      allow list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.role == "leader"
        && request.resource.data.active == true
        && request.resource.data.displayName is string
        && request.resource.data.email is string
        && request.resource.data.sections is list
        && request.resource.data.sections.size() > 0
        && !request.resource.data.keys().hasAny(["section"]);
      allow update: if (request.auth.uid == userId && isActiveLeader()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["displayName", "mobileNumber"]))
        || (isAdmin() && resource.data.role == "leader"
          && request.resource.data.role == "leader"
          && request.resource.data.sections is list
          && request.resource.data.sections.size() > 0
          && !request.resource.data.keys().hasAny(["section"])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["active", "sections", "displayName", "mobileNumber", "updatedAt", "updatedBy"]))
        || (isSuperAdmin() && resource.data.role != "super-admin"
          && request.resource.data.role in ["leader", "admin"]
          && request.resource.data.sections is list
          && request.resource.data.sections.size() > 0
          && !request.resource.data.keys().hasAny(["section"])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["active", "role", "sections", "displayName", "mobileNumber", "updatedAt", "updatedBy"]));
      allow delete: if false;
    }

    match /parentAccounts/{userId} {
      allow create: if signedIn() && request.auth.uid == userId && request.resource.data.uid == userId
        && request.resource.data.status == "pending" && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() == 0 && request.resource.data.linkedSections is list
        && request.resource.data.linkedSections.size() == 0;
      allow get: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow list: if isAdmin();
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "memberIds", "linkedSections", "reviewedBy", "reviewedAt", "updatedAt"]);
      allow delete: if false;
    }

    match /leaderRegistrationRequests/{userId} {
      allow create: if signedIn() && request.auth.uid == userId && request.resource.data.uid == userId && request.resource.data.status == "pending" && request.resource.data.privacyConfirmed == true;
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "reviewedAt", "reviewedBy", "reviewNote"]);
      allow delete: if false;
    }

    match /joinApplications/{applicationId} {
      allow create: if request.resource.data.childFirstName is string && request.resource.data.childLastName is string
        && request.resource.data.dateOfBirth is string && request.resource.data.parentName is string
        && request.resource.data.emailAddress is string && request.resource.data.mobileNumber is string
        && request.resource.data.emergencyContactName is string && request.resource.data.emergencyContactPhone is string
        && request.resource.data.section is string
        && request.resource.data.informationConfirmed == true && request.resource.data.contactConsent == true
        && request.resource.data.status == "new" && request.resource.data.source == "website" && request.resource.data.submittedAt == request.time
        && !request.resource.data.keys().hasAny(["childDob", "dob", "childName", "name", "phone", "phoneNumber", "parentPhone", "parentMobile", "scoutSection"]);
      allow read: if isActiveLeader() && hasSection(resource.data.section);
      allow update: if isActiveLeader() && hasSection(resource.data.section) && hasSection(request.resource.data.section)
        && request.resource.data.status in ["new", "contacted", "waiting-list", "accepted", "closed"]
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "notes", "contactHistory", "updatedAt", "memberId", "convertedAt", "convertedBy"]);
      allow delete: if false;
    }

    match /members/{memberId} {
      allow create: if isActiveLeader() && hasSection(request.resource.data.section) && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.firstName is string && request.resource.data.lastName is string
        && request.resource.data.displayName is string && request.resource.data.dateOfBirth is string
        && request.resource.data.status in ["active", "inactive", "left"]
        && ((request.resource.data.source == "join-application" && request.resource.data.status == "active") || request.resource.data.source == "manual");
      allow read: if (isActiveLeader() && (hasSection(resource.data.section) || isGroupLeader() || isGroupSecretary())) || isApprovedParentForMember(memberId);
      allow update: if isActiveLeader() && hasSection(resource.data.section) && hasSection(request.resource.data.section)
        && request.resource.data.status in ["active", "inactive", "left"]
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["firstName", "lastName", "displayName", "dateOfBirth", "section", "parentName", "emailAddress", "mobileNumber", "emergencyContactName", "emergencyContactPhone", "status", "updatedAt", "updatedBy"]);
      allow delete: if false;
    }

    match /memberHistory/{entryId} {
      allow read: if isActiveLeader()
        && resource.data.memberId is string
        && exists(/databases/$(database)/documents/members/$(resource.data.memberId))
        && hasSection(get(/databases/$(database)/documents/members/$(resource.data.memberId)).data.section);
      allow create: if isActiveLeader()
        && request.resource.data.memberId is string
        && request.resource.data.memberName is string
        && request.resource.data.changeType in ["section-transfer", "status-change", "section-and-status-change"]
        && request.resource.data.fromSection is string
        && request.resource.data.toSection is string
        && request.resource.data.fromStatus in ["active", "inactive", "left"]
        && request.resource.data.toStatus in ["active", "inactive", "left"]
        && request.resource.data.changedBy == request.auth.uid
        && request.resource.data.changedAt == request.time
        && hasSection(request.resource.data.fromSection)
        && hasSection(request.resource.data.toSection)
        && request.resource.data.keys().hasOnly(["memberId", "memberName", "changeType", "fromSection", "toSection", "fromStatus", "toStatus", "changedBy", "changedAt"]);
      allow update, delete: if false;
    }

    match /events/{eventId} {
      allow read: if isActiveLeader() && hasSection(resource.data.section);
      allow create: if isActiveLeader() && hasSection(request.resource.data.section) && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.title is string && request.resource.data.eventType is string
        && request.resource.data.startDate is string && request.resource.data.endDate is string
        && request.resource.data.status in ["draft", "open", "closed", "completed"];
      allow update: if isActiveLeader() && hasSection(resource.data.section) && hasSection(request.resource.data.section)
        && request.resource.data.status in ["draft", "open", "closed", "completed"]
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["title", "description", "eventType", "section", "location", "meetingPoint", "returnDetails", "leaderNotes", "startDate", "endDate", "status", "consentRequired", "attendance", "consent", "updatedAt", "updatedBy"]);
      allow delete: if false;
    }

    match /publicEvents/{eventId} {
      allow read: if resource.data.eventId == eventId
        && resource.data.title is string && resource.data.eventType is string
        && resource.data.section is string && resource.data.startDate is string && resource.data.endDate is string;
      allow create: if isActiveLeader()
        && hasSection(request.resource.data.section)
        && request.resource.data.eventId == eventId
        && request.resource.data.keys().hasOnly(["eventId", "title", "description", "eventType", "section", "location", "startDate", "endDate", "updatedAt"]);
      allow update: if isActiveLeader()
        && hasSection(resource.data.section)
        && hasSection(request.resource.data.section)
        && request.resource.data.eventId == eventId
        && request.resource.data.keys().hasOnly(["eventId", "title", "description", "eventType", "section", "location", "startDate", "endDate", "updatedAt"]);
      allow delete: if isActiveLeader() && (isAdmin() || hasSection(resource.data.section));
    }

    match /eventConsentLinks/{token} {
      allow get: if (isActiveLeader() && hasSection(resource.data.section)) || resource.data.active == true;
      allow list: if (isActiveLeader() && hasSection(resource.data.section)) || (resource.data.active == true && isApprovedParentForSection(resource.data.section));
      allow create: if isActiveLeader() && hasSection(request.resource.data.section)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.eventId is string && request.resource.data.title is string
        && request.resource.data.eventType is string && request.resource.data.startDate is string
        && request.resource.data.endDate is string && request.resource.data.active is bool;
      allow update: if isActiveLeader() && hasSection(resource.data.section) && hasSection(request.resource.data.section)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["eventId", "title", "description", "eventType", "section", "location", "meetingPoint", "returnDetails", "startDate", "endDate", "consentRequired", "active", "updatedAt"]);
      allow delete: if false;
    }

    match /eventConsentResponses/{responseId} {
      allow create: if request.resource.data.token is string && request.resource.data.eventId is string && request.resource.data.childName is string
        && request.resource.data.dateOfBirth is string && request.resource.data.parentName is string && request.resource.data.attendance in ["attending", "not-attending"]
        && request.resource.data.consentGiven is bool && request.resource.data.emergencyDetailsConfirmed is bool && request.resource.data.medicalDetailsChanged is bool
        && request.resource.data.processingStatus == "new" && request.resource.data.submittedAt == request.time
        && exists(/databases/$(database)/documents/eventConsentLinks/$(request.resource.data.token))
        && get(/databases/$(database)/documents/eventConsentLinks/$(request.resource.data.token)).data.active == true
        && get(/databases/$(database)/documents/eventConsentLinks/$(request.resource.data.token)).data.eventId == request.resource.data.eventId;
      allow read: if isAdmin();
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["processingStatus", "matchedMemberId", "processedBy", "processedAt"])
        && request.resource.data.processingStatus in ["matched", "ignored"] && request.resource.data.processedBy == request.auth.uid;
      allow delete: if false;
    }

    match /consentApplications/{consentId} {
      allow create: if request.resource.data.status == "active"
        && request.resource.data.source == "website"
        && request.resource.data.submittedAt == request.time
        && request.resource.data.section is string
        && request.resource.data.formType in ["youth-activity-consent", "scouter-es3-medical-advice"]
        && request.resource.data.formVersion is string
        && !request.resource.data.keys().hasAny(["scoutSection", "expiryDate", "medicalConditions", "medicationRequired"]);
      allow read: if (isActiveLeader() && (isAdmin() || hasResourceSection(resource.data)))
        || (resource.data.memberId is string && isApprovedParentForMember(resource.data.memberId));
      allow update: if (isActiveLeader() && (isAdmin() || hasResourceSection(resource.data))
          && request.resource.data.formType in ["youth-activity-consent", "scouter-es3-medical-advice"]
          && !request.resource.data.keys().hasAny(["scoutSection"])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "memberId", "linkedBy", "linkedAt", "updatedAt"]))
        || (resource.data.formType == "youth-activity-consent" && resource.data.memberId is string
          && isApprovedParentForMember(resource.data.memberId) && request.resource.data.memberId == resource.data.memberId
          && request.resource.data.parentUpdatedBy == request.auth.uid
          && !request.resource.data.keys().hasAny(["scoutSection"])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["consentFrom", "consentTo", "photoConsent", "waterActivities", "canSwim", "seriousIllness", "regularMeds", "medAllergies", "allergies", "dietaryReqs", "vaccinated", "medicalFurtherInfo", "gpName", "gpTel", "gpAddress", "lastCheckup", "parent1Name", "parent2Name", "homePhone", "mobile1", "workPhone", "email", "homeAddress", "altContactName", "altContactPhone", "additionalInfo", "medicationManagement", "updatedByParent", "parentUpdatedBy", "parentUpdatedAt", "updatedAt"]));
      allow delete: if false;
    }

    match /meetingRecords/{meetingId} {
      allow read: if isAdmin()
        || (isActiveLeader()
          && exists(/databases/$(database)/documents/organisationLeadership/$(request.auth.uid))
          && get(/databases/$(database)/documents/organisationLeadership/$(request.auth.uid)).data.active == true
          && get(/databases/$(database)/documents/organisationLeadership/$(request.auth.uid)).data.scoutingRole in ["Group Leader", "Group Secretary"])
        || (isActiveLeader()
          && resource.data.meetingType == "leader"
          && resource.data.section is string
          && hasSection(resource.data.section));
      allow create: if isActiveLeader()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.meetingDate is string
        && request.resource.data.attendees is list
        && request.resource.data.meetingType in ["group", "leader"]
        && ((request.resource.data.meetingType == "group" && isAdmin() && request.resource.data.section == "Group")
          || (request.resource.data.meetingType == "leader" && request.resource.data.section is string && hasSection(request.resource.data.section)))
        && request.resource.data.keys().hasOnly(["title", "meetingType", "section", "meetingDate", "attendees", "notes", "decisions", "actions", "createdBy", "createdAt", "updatedBy", "updatedAt"]);
      allow update: if isActiveLeader()
        && ((resource.data.meetingType == "group" && isAdmin())
          || (resource.data.meetingType == "leader" && resource.data.section is string && hasSection(resource.data.section)))
        && ((request.resource.data.meetingType == "group" && isAdmin() && request.resource.data.section == "Group")
          || (request.resource.data.meetingType == "leader" && request.resource.data.section is string && hasSection(request.resource.data.section)))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["title", "meetingType", "section", "meetingDate", "attendees", "notes", "decisions", "actions", "updatedBy", "updatedAt"])
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    match /weeklyMeetings/{weeklyMeetingId} {
      allow read: if isActiveLeader()
        && resource.data.section is string
        && (hasSection(resource.data.section) || isGroupLeader() || isGroupSecretary());
      allow create: if isActiveLeader()
        && request.resource.data.section is string
        && (hasSection(request.resource.data.section) || isGroupLeader())
        && request.resource.data.meetingDate is string
        && request.resource.data.status in ["open", "closed"]
        && request.resource.data.location is string
        && request.resource.data.plannedActivities is string
        && request.resource.data.plannedBadgework is string
        && request.resource.data.programmeNotes is string
        && request.resource.data.notes is string
        && request.resource.data.entries is list
        && request.resource.data.injuries is list
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.keys().hasOnly(["section", "meetingDate", "status", "location", "plannedActivities", "plannedBadgework", "programmeNotes", "notes", "entries", "injuries", "createdBy", "createdAt", "updatedBy", "updatedAt"]);
      allow update: if isActiveLeader()
        && resource.data.section is string
        && request.resource.data.section is string
        && (hasSection(resource.data.section) || isGroupLeader())
        && (hasSection(request.resource.data.section) || isGroupLeader())
        && request.resource.data.status in ["open", "closed"]
        && request.resource.data.location is string
        && request.resource.data.plannedActivities is string
        && request.resource.data.plannedBadgework is string
        && request.resource.data.programmeNotes is string
        && request.resource.data.notes is string
        && request.resource.data.entries is list
        && request.resource.data.injuries is list
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["section", "meetingDate", "status", "location", "plannedActivities", "plannedBadgework", "programmeNotes", "notes", "entries", "injuries", "updatedBy", "updatedAt"]);
      allow delete: if false;
    }

    match /parentWeeklyMeetings/{weeklyMeetingId} {
      allow get, list: if resource.data.section is string && isApprovedParentForSection(resource.data.section);
      allow create: if isActiveLeader()
        && request.resource.data.section is string
        && (hasSection(request.resource.data.section) || isGroupLeader())
        && request.resource.data.meetingDate is string
        && request.resource.data.status in ["open", "closed"]
        && request.resource.data.location is string
        && request.resource.data.theme is string
        && request.resource.data.activities is list
        && request.resource.data.badgework is list
        && request.resource.data.keys().hasOnly(["section", "meetingDate", "status", "location", "theme", "activities", "badgework", "updatedAt"]);
      allow update: if isActiveLeader()
        && resource.data.section is string
        && request.resource.data.section is string
        && (hasSection(resource.data.section) || isGroupLeader())
        && (hasSection(request.resource.data.section) || isGroupLeader())
        && request.resource.data.meetingDate is string
        && request.resource.data.status in ["open", "closed"]
        && request.resource.data.location is string
        && request.resource.data.theme is string
        && request.resource.data.activities is list
        && request.resource.data.badgework is list
        && request.resource.data.keys().hasOnly(["section", "meetingDate", "status", "location", "theme", "activities", "badgework", "updatedAt"]);
      allow delete: if false;
    }

    match /organisationLeadership/{leaderId} {
      allow read: if isActiveLeader();
      allow create, update: if isAdmin()
        && request.resource.data.displayName is string
        && request.resource.data.scoutingRole is string
        && request.resource.data.organisationSection is string
        && request.resource.data.organisationOrder is number
        && request.resource.data.reportsToUid is string
        && request.resource.data.showPublicly is bool
        && request.resource.data.active == true
        && request.resource.data.keys().hasOnly(["displayName", "scoutingRole", "organisationSection", "organisationOrder", "reportsToUid", "showPublicly", "active", "updatedAt"]);
      allow delete: if isAdmin();
    }

    match /publicLeadership/{leaderId} {
      allow get, list: if resource.data.publicProjectionVersion == 2
        && resource.data.sourceAccessRole == "leader"
        && resource.data.active == true
        && resource.data.showPublicly == true;
      allow create, update: if isAdmin()
        && request.resource.data.displayName is string
        && request.resource.data.scoutingRole is string
        && request.resource.data.organisationSection is string
        && request.resource.data.organisationOrder is number
        && request.resource.data.reportsToUid is string
        && request.resource.data.showPublicly == true
        && request.resource.data.active == true
        && request.resource.data.publicProjectionVersion == 2
        && request.resource.data.sourceAccessRole == "leader"
        && request.resource.data.keys().hasOnly(["displayName", "scoutingRole", "organisationSection", "organisationOrder", "reportsToUid", "showPublicly", "active", "publicProjectionVersion", "sourceAccessRole", "updatedAt"]);
      allow delete: if isAdmin();
    }

    match /publicSiteContent/{contentId} {
      allow get: if contentId == "TEST_site"
        && resource.data.contentVersion == 1
        && resource.data.testData == true
        && resource.data.testSeed == "public-site-content-v1"
        && resource.data.createdBySeed == "TEST_SEED";
      allow list, create, update, delete: if false;
    }

    match /auditLog/{entryId} {
      allow get, list: if isAdmin();
      allow create: if isActiveLeader()
        && request.resource.data.actorUid == request.auth.uid
        && request.auth.token.email is string
        && request.resource.data.actorEmail == request.auth.token.email
        && request.resource.data.category in ["parent-access", "leader-request", "leader-access", "member", "event", "event-consent", "system"]
        && request.resource.data.action is string
        && request.resource.data.targetId is string
        && request.resource.data.targetLabel is string
        && request.resource.data.description is string
        && request.resource.data.section is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly(["category", "action", "actorUid", "actorEmail", "targetId", "targetLabel", "description", "section", "createdAt"]);
      allow update, delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}