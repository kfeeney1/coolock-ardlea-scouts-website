        : section in ["Cubs", "Cub", "Cub Scout", "Cub Scouts"]
          ? ["Cubs", "Cub", "Cub Scout", "Cub Scouts"]
          : section in ["Scouts", "Scout"]
            ? ["Scouts", "Scout"]
            : section in ["Ventures", "Venture", "Venture Scout", "Venture Scouts"]
              ? ["Ventures", "Venture", "Venture Scout", "Venture Scouts"]
              : section in ["Rovers", "Rover", "Rover Scout", "Rover Scouts"]
                ? ["Rovers", "Rover", "Rover Scout", "Rover Scouts"]
                : [section];
    }
    // Call only after isActiveLeader() has been established by the enclosing rule.
    // Keeping this helper to section-overlap checks avoids repeatedly expanding the
    // authentication/profile predicates and hitting Firestore's expression limit.
    function canAccessMemberSections(data) {
