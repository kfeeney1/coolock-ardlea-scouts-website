rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function adminProfilePath() {
      return /databases/(default)/documents/adminUsers/$(request.auth.uid);
    }
    function profile() {
      return firestore.get(adminProfilePath()).data;
    }
    function parentProfile() {
      return firestore.get(/databases/(default)/documents/parentAccounts/$(request.auth.uid)).data;
    }
    function isActiveLeader() {
      return signedIn()
        && (firestore.exists(adminProfilePath())
          ? profile().get("active", false) == true
            && profile().get("role", "") in ["leader", "admin", "super-admin"]
            && profile().get("sections", []) is list
            && profile().get("sections", []).size() > 0
          : false);
    }
    function isApprovedParent() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/parentAccounts/$(request.auth.uid))
        && parentProfile().status == "approved"
        && parentProfile().memberIds is list
        && parentProfile().linkedSections is list;
    }
    function isAdmin() {
      return isActiveLeader()
        ? profile().get("role", "") in ["admin", "super-admin"]
        : false;
    }
    function leadershipPath() {
      return /databases/(default)/documents/organisationLeadership/$(request.auth.uid);
    }
    function hasLeadershipRole(role) {
      return isActiveLeader()
        && (firestore.exists(leadershipPath())
          ? firestore.get(leadershipPath()).data.get("active", false) == true
            && firestore.get(leadershipPath()).data.get("scoutingRole", "") == role
          : false);
    }
    function canViewAllFinance() {
      return isAdmin() || hasLeadershipRole("Group Leader") || hasLeadershipRole("Group Treasurer");
    }
    function canAccessFinanceSection(section) {
      return isActiveLeader()
        ? canViewAllFinance() || section in profile().get("sections", [])
        : false;
    }
    function canAccessGallerySection(section) {
      return isActiveLeader()
        ? isAdmin() || hasLeadershipRole("Group Leader") || section in profile().get("sections", [])
        : false;
    }
    function galleryAccessPath(eventId) {
      return /databases/(default)/documents/eventGalleryAccess/$(eventId)/parents/$(request.auth.uid);
    }
    function galleryAccess(eventId) {
      return firestore.get(galleryAccessPath(eventId)).data;
    }
    function galleryConsentId(eventId) {
      return galleryAccess(eventId).get("consentApplicationId", "__missing__");
    }
    function galleryConsent(eventId) {
      return firestore.get(/databases/(default)/documents/consentApplications/$(galleryConsentId(eventId))).data;
    }
    function galleryEvent(eventId) {
      return firestore.get(/databases/(default)/documents/events/$(eventId)).data;
    }
    function canParentReadProjectedGallery(section, eventId) {
      return galleryAccess(eventId).get("active", false) == true
        && galleryAccess(eventId).get("parentUid", "") == request.auth.uid
        && galleryAccess(eventId).get("eventId", "") == eventId
        && galleryAccess(eventId).get("section", "") == section
        && galleryAccess(eventId).get("memberId", "") is string
        && galleryAccess(eventId).get("memberId", "") in parentProfile().memberIds
        && section in parentProfile().linkedSections
        && firestore.exists(/databases/(default)/documents/events/$(eventId))
        && galleryEvent(eventId).get("section", "") == section
        && galleryEvent(eventId).get("attendance", {}).get(galleryAccess(eventId).get("memberId", "__missing__"), "") == "attending"
        && galleryAccess(eventId).get("consentApplicationId", "") is string
        && firestore.exists(/databases/(default)/documents/consentApplications/$(galleryConsentId(eventId)))
        && galleryConsent(eventId).get("formType", "") == "youth-activity-consent"
        && galleryConsent(eventId).get("status", "") == "active"
        && galleryConsent(eventId).get("memberId", "") == galleryAccess(eventId).get("memberId", "")
        && galleryConsent(eventId).get("section", "") == section
        && galleryConsent(eventId).get("photoConsent", "") == "Yes";
    }
    function canParentReadGallery(section, eventId) {
      return isApprovedParent()
        && (firestore.exists(galleryAccessPath(eventId))
          ? canParentReadProjectedGallery(section, eventId)
          : false);
    }
    function validReceiptWrite(section) {
      return canAccessFinanceSection(section)
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in ["image/jpeg", "image/png", "image/webp", "application/pdf"]
        && request.resource.metadata.ownerType == "finance-receipt"
        && request.resource.metadata.section == section
        && request.resource.metadata.uploadedBy == request.auth.uid;
    }
    function validEventGalleryWrite(section, eventId) {
      return canAccessGallerySection(section)
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in ["image/jpeg", "image/png", "image/webp"]
        && request.resource.metadata.ownerType == "event-gallery"
        && request.resource.metadata.ownerId == eventId
        && request.resource.metadata.section == section
        && request.resource.metadata.uploadedBy == request.auth.uid;
    }

    match /attachments/finance-receipts/{section}/{allPaths=**} {
      allow list: if canAccessFinanceSection(section);
    }

    match /attachments/finance-receipts/{section}/{attachmentId}/{fileName} {
      allow get: if canAccessFinanceSection(section);
      allow create: if validReceiptWrite(section);
      allow update: if false;
      allow delete: if canAccessFinanceSection(section)
        && resource.metadata.ownerType == "finance-receipt"
        && resource.metadata.section == section;
    }

    // Leaders retain section-scoped discovery. Parents never receive section-wide
    // discovery; they may list only an exact event path after all live checks pass.
    match /attachments/event-gallery/{section}/{allPaths=**} {
      allow list: if canAccessGallerySection(section);
    }

    match /attachments/event-gallery/{section}/{eventId}/{allPaths=**} {
      allow list: if canParentReadGallery(section, eventId);
    }

    match /attachments/event-gallery/{section}/{eventId}/{attachmentId}/{fileName} {
      allow get: if canAccessGallerySection(section) || canParentReadGallery(section, eventId);
      allow create: if validEventGalleryWrite(section, eventId);
      allow update: if false;
      allow delete: if canAccessGallerySection(section)
        && resource.metadata.ownerType == "event-gallery"
        && resource.metadata.ownerId == eventId
        && resource.metadata.section == section;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
