rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function profile() {
      return firestore.get(/databases/(default)/documents/adminUsers/$(request.auth.uid)).data;
    }
    function parentProfile() {
      return firestore.get(/databases/(default)/documents/parentAccounts/$(request.auth.uid)).data;
    }
    function isActiveLeader() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/adminUsers/$(request.auth.uid))
        && profile().active == true
        && profile().role in ["leader", "admin", "super-admin"]
        && profile().sections is list
        && profile().sections.size() > 0;
    }
    function isApprovedParent() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/parentAccounts/$(request.auth.uid))
        && parentProfile().status == "approved"
        && parentProfile().memberIds is list;
    }
    function isAdmin() { return isActiveLeader() && profile().role in ["admin", "super-admin"]; }
    function leadershipRole() {
      return firestore.get(/databases/(default)/documents/organisationLeadership/$(request.auth.uid)).data.scoutingRole;
    }
    function hasLeadershipRole(role) {
      return isActiveLeader()
        && firestore.exists(/databases/(default)/documents/organisationLeadership/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/organisationLeadership/$(request.auth.uid)).data.active == true
        && leadershipRole() == role;
    }
    function canViewAllFinance() {
      return isAdmin() || hasLeadershipRole("Group Leader") || hasLeadershipRole("Group Treasurer");
    }
    function canAccessFinanceSection(section) {
      return isActiveLeader() && (canViewAllFinance() || section in profile().sections);
    }
    function canAccessGallerySection(section) {
      return isActiveLeader() && (isAdmin() || hasLeadershipRole("Group Leader") || section in profile().sections);
    }
    function galleryAccess(section, eventId) {
      return firestore.get(/databases/(default)/documents/galleryAccess/$(request.auth.uid)/events/$(eventId)).data;
    }
    function canParentReadGallery(section, eventId) {
      return isApprovedParent()
        && firestore.exists(/databases/(default)/documents/galleryAccess/$(request.auth.uid)/events/$(eventId))
        && galleryAccess(section, eventId).active == true
        && galleryAccess(section, eventId).parentUid == request.auth.uid
        && galleryAccess(section, eventId).eventId == eventId
        && galleryAccess(section, eventId).section == section
        && galleryAccess(section, eventId).memberIds is list
        && galleryAccess(section, eventId).memberIds.size() > 0;
    }
    function validReceiptWrite(section) {
      return canAccessFinanceSection(section)
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in ["image/jpeg", "image/png", "image/webp", "application/pdf"]
        && request.resource.metadata.ownerType == "finance-receipt"
        && request.resource.metadata.section == section
        && request.resource.metadata.uploadedBy == request.auth.uid;
    }
    function validEventGalleryWrite(section, eventId) {
      return canAccessGallerySection(section)
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in ["image/jpeg", "image/png", "image/webp"]
        && request.resource.metadata.ownerType == "event-gallery"
        && request.resource.metadata.ownerId == eventId
        && request.resource.metadata.section == section
        && request.resource.metadata.uploadedBy == request.auth.uid;
    }

    match /attachments/finance-receipts/{section}/{allPaths=**} {
      allow list: if canAccessFinanceSection(section);
    }

    match /attachments/finance-receipts/{section}/{attachmentId}/{fileName} {
      allow get: if canAccessFinanceSection(section);
      allow create: if validReceiptWrite(section);
      allow update: if false;
      allow delete: if canAccessFinanceSection(section)
        && resource.metadata.ownerType == "finance-receipt"
        && resource.metadata.section == section;
    }

    // Leaders retain section-scoped discovery. Parents never receive section-wide
    // discovery; they may list only an event path with an active access projection.
    match /attachments/event-gallery/{section}/{allPaths=**} {
      allow list: if canAccessGallerySection(section);
    }

    match /attachments/event-gallery/{section}/{eventId}/{allPaths=**} {
      allow list: if canParentReadGallery(section, eventId);
    }

    match /attachments/event-gallery/{section}/{eventId}/{attachmentId}/{fileName} {
      allow get: if canAccessGallerySection(section) || canParentReadGallery(section, eventId);
      allow create: if validEventGalleryWrite(section, eventId);
      allow update: if false;
      allow delete: if canAccessGallerySection(section)
        && resource.metadata.ownerType == "event-gallery"
        && resource.metadata.ownerId == eventId
        && resource.metadata.section == section;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
