rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /maintenance-documents/{document=**} {
      allow read, write: if false;
    }
    function signedIn() { return request.auth != null; }
    // Two canonical Firestore lookups fit Storage's cross-service access limit.
    // Rollout gates the routes and Firestore operations; Storage enforces membership separately.
    function maintenanceStorageMember() {
      let access = firestore.get(/databases/(default)/documents/maintenance/group/access/$(request.auth.uid)).data;
      let source = access.kind == "leader"
        ? firestore.get(/databases/(default)/documents/adminUsers/$(request.auth.uid)).data
        : access.kind == "parent"
          ? firestore.get(/databases/(default)/documents/parentAccounts/$(request.auth.uid)).data
          : firestore.get(/databases/(default)/documents/members/$(access.sourceId)).data;
      return (access.kind == "leader" && access.sourceId == request.auth.uid
          && source.get("active", false) == true && source.get("role", "") in ["leader", "admin", "super-admin"]
          && source.get("sections", []) is list && source.get("sections", []).size() > 0 && !source.keys().hasAny(["section"]))
        || (access.kind == "parent" && access.sourceId == request.auth.uid && source.get("status", "") == "approved")
        || (access.kind == "member" && source.get("accountUid", "") == request.auth.uid && source.get("status", "") == "active");
    }
    match /maintenance-documents/{id} {
      allow get: if signedIn() && maintenanceStorageMember();
      allow create: if signedIn() && maintenanceStorageMember() && id.matches('^[a-zA-Z0-9-]{20,64}$')
        && request.resource.size > 0 && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in ["application/pdf", "image/jpeg", "image/png", "image/webp"]
        && request.resource.metadata.keys().hasOnly(["uploadedBy", "sha256", "documentId"])
        && request.resource.metadata.uploadedBy == request.auth.uid
        && request.resource.metadata.sha256.matches('^[a-f0-9]{64}$') && request.resource.metadata.documentId == id;
      allow list, update, delete: if false;
    }

    function adminProfilePath() { return /databases/(default)/documents/adminUsers/$(request.auth.uid); }
    function profile() { return firestore.get(adminProfilePath()).data; }
    function parentProfilePath() { return /databases/(default)/documents/parentAccounts/$(request.auth.uid); }
    function parentProfile() { return firestore.get(parentProfilePath()).data; }
    function isActiveLeader() {
      return signedIn() && (firestore.exists(adminProfilePath())
        ? profile().get("active", false) == true
          && profile().get("role", "") in ["leader", "admin", "super-admin"]
          && profile().get("sections", []) is list
          && profile().get("sections", []).size() > 0
        : false);
    }
    function isApprovedParent() {
      return signedIn() && (firestore.exists(parentProfilePath())
        ? parentProfile().get("status", "") == "approved"
          && parentProfile().get("memberIds", []) is list
          && parentProfile().get("linkedSections", []) is list
        : false);
    }
    function isAdmin() { return isActiveLeader() ? profile().get("role", "") in ["admin", "super-admin"] : false; }
    function leadershipPath() { return /databases/(default)/documents/organisationLeadership/$(request.auth.uid); }
    function groupAppointmentDateAllows(value, endDate) {
      return value == "" || (value is string
        && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && groupAppointmentDateIncludesToday(value, endDate));
    }
    function groupAppointmentDateIncludesToday(value, endDate) {
      let parts = value.split('-');
      let year = int(parts[0]);
      let month = int(parts[1]);
      let day = int(parts[2]);
      let date = timestamp.date(year, month, day);
      return date.year() == year && date.month() == month && date.day() == day
        && (endDate ? request.time < date + duration.value(1, 'd') : date <= request.time);
    }
    function groupAppointmentAt(items, index, roles) {
      return items.size() > index && matchesGroupAppointment(items[index], roles);
    }
    function matchesGroupAppointment(item, roles) {
      return item is map
        && item.get("scope", "Group") == "Group"
        && item.get("active", true) == true
        && item.get("appointment", "") is string
        && item.get("appointment", "").lower() in roles
        && groupAppointmentDateAllows(item.get("startDate", ""), false)
        && groupAppointmentDateAllows(item.get("endDate", ""), true);
    }
    // The canonical writer supports twelve slots. A populated list supersedes
    // the scalar label, including when all its appointments are ineffective.
    function hasGroupAppointment(data, roles) {
      let items = data.get("appointments", []);
      return data.get("active", false) == true && items is list && items.size() <= 12
        && (items.size() == 0
          ? data.get("scoutingRole", "") is string && data.get("scoutingRole", "").lower() in roles
          : groupAppointmentAt(items, 0, roles) || groupAppointmentAt(items, 1, roles)
            || groupAppointmentAt(items, 2, roles) || groupAppointmentAt(items, 3, roles)
            || groupAppointmentAt(items, 4, roles) || groupAppointmentAt(items, 5, roles)
            || groupAppointmentAt(items, 6, roles) || groupAppointmentAt(items, 7, roles)
            || groupAppointmentAt(items, 8, roles) || groupAppointmentAt(items, 9, roles)
            || groupAppointmentAt(items, 10, roles) || groupAppointmentAt(items, 11, roles));
    }
    function groupLeadershipRoles() {
      return ["group leader", "deputy group leader", "deputy-group-leader", "deputy grouplead", "dgl"];
    }
    // Call only after verifying the caller is an active leader.
    function currentGroupAppointment(roles) {
      return firestore.exists(leadershipPath()) && hasGroupAppointment(firestore.get(leadershipPath()).data, roles);
    }
    function canAccessLeaderSection(section, groupRoles) {
      return isActiveLeader() && (section in profile().get("sections", [])
        || profile().get("role", "") in ["admin", "super-admin"]
        || currentGroupAppointment(groupRoles));
    }
    function canAccessFinanceSection(section) {
      return canAccessLeaderSection(section, groupLeadershipRoles().concat(["group treasurer"]));
    }
    function canAccessGallerySection(section) {
      return canAccessLeaderSection(section, groupLeadershipRoles());
    }
    function galleryAccessPath(eventId) { return /databases/(default)/documents/eventGalleryAccess/$(eventId)/parents/$(request.auth.uid); }
    function galleryAccess(eventId) { return firestore.get(galleryAccessPath(eventId)).data; }
    function galleryConsentId(eventId) { return galleryAccess(eventId).get("consentApplicationId", "__missing__"); }
    function galleryConsent(eventId) { return firestore.get(/databases/(default)/documents/consentApplications/$(galleryConsentId(eventId))).data; }
    function galleryEvent(eventId) { return firestore.get(/databases/(default)/documents/events/$(eventId)).data; }
    function canParentReadProjectedGallery(section, eventId) {
      return galleryAccess(eventId).get("active", false) == true
        && galleryAccess(eventId).get("parentUid", "") == request.auth.uid
        && galleryAccess(eventId).get("eventId", "") == eventId
        && galleryAccess(eventId).get("section", "") == section
        && galleryAccess(eventId).get("memberId", "") is string
        && galleryAccess(eventId).get("memberId", "") in parentProfile().get("memberIds", [])
        && firestore.exists(/databases/(default)/documents/events/$(eventId))
        && galleryEvent(eventId).get("section", "") == section
        && galleryEvent(eventId).get("attendance", {}).get(galleryAccess(eventId).get("memberId", "__missing__"), "") == "attending"
        && galleryAccess(eventId).get("consentApplicationId", "") is string
        && firestore.exists(/databases/(default)/documents/consentApplications/$(galleryConsentId(eventId)))
        && galleryConsent(eventId).get("formType", "") == "youth-activity-consent"
        && galleryConsent(eventId).get("status", "") == "active"
        && galleryConsent(eventId).get("memberId", "") == galleryAccess(eventId).get("memberId", "")
        && galleryConsent(eventId).get("section", "") == section
        && galleryConsent(eventId).get("photoConsent", "") == "Yes";
    }
    function canParentReadGallery(section, eventId) {
      return signedIn() && (firestore.exists(galleryAccessPath(eventId)) ? isApprovedParent() && canParentReadProjectedGallery(section, eventId) : false);
    }
    function validReceiptWrite(section) {
      return canAccessFinanceSection(section) && resource == null && request.resource != null
        && request.resource.size > 0 && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in ["image/jpeg", "image/png", "image/webp", "application/pdf"]
        && request.resource.metadata.ownerType == "finance-receipt"
        && request.resource.metadata.section == section
        && request.resource.metadata.uploadedBy == request.auth.uid;
    }
    function validEventGalleryWrite(section, eventId) {
      // A gallery upload must not outlive its event or race with deletion.
      // Only the trusted backend may set deletionState on the event.
      return canAccessGallerySection(section)
        && firestore.exists(/databases/(default)/documents/events/$(eventId))
        && firestore.get(/databases/(default)/documents/events/$(eventId)).data.get("section", "") == section
        && firestore.get(/databases/(default)/documents/events/$(eventId)).data.get("deletionState", "") == ""
        && request.resource != null
        && request.resource.size > 0 && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in ["image/jpeg", "image/png", "image/webp"]
        && request.resource.metadata.ownerType == "event-gallery"
        && request.resource.metadata.ownerId == eventId
        && request.resource.metadata.section == section
        && request.resource.metadata.uploadedBy == request.auth.uid;
    }
    function hasGroupLeadershipRole() {
      return isActiveLeader() && currentGroupAppointment(groupLeadershipRoles());
    }
    function canManagePolicies() { return isAdmin() || hasGroupLeadershipRole(); }
    function canReadPolicyAudience(audience) {
      return audience == "public"
        || (audience == "authenticated" && (isActiveLeader() || isApprovedParent()))
        || (audience == "parent" && isApprovedParent())
        || (audience == "leader" && isActiveLeader())
        || (audience == "admin" && canManagePolicies());
    }
    function policyMetadataPath(documentId) { return /databases/(default)/documents/policyDocuments/$(documentId); }
    function policyMetadata(documentId) { return firestore.get(policyMetadataPath(documentId)).data; }
    function canReadCurrentPolicy(audience, documentId, versionId) {
      return canReadPolicyAudience(audience)
        && firestore.exists(policyMetadataPath(documentId))
        && policyMetadata(documentId).get("state", "") == "current"
        && policyMetadata(documentId).get("audience", "") == audience
        && policyMetadata(documentId).get("documentId", "") == documentId
        && policyMetadata(documentId).get("versionId", "") == versionId;
    }
    function validPolicyWrite(audience, documentId, versionId) {
      return canManagePolicies() && resource == null && request.resource != null
        && request.resource.size > 0 && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType == "application/pdf"
        && request.resource.metadata.ownerType == "policy-document"
        && request.resource.metadata.documentId == documentId
        && request.resource.metadata.versionId == versionId
        && request.resource.metadata.audience == audience
        && request.resource.metadata.state == "current"
        && request.resource.metadata.publishedBy == request.auth.uid;
    }
    function canAccessMeetingSection(section) {
      return canAccessLeaderSection(section, groupLeadershipRoles().concat(["group secretary"]));
    }
    function validMeetingDocumentWrite(section, meetingId) {
      return canAccessMeetingSection(section) && resource == null && request.resource != null
        && request.resource.size > 0 && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in ["application/pdf", "application/msword", "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "application/vnd.oasis.opendocument.text", "text/plain", "text/markdown", "text/html"]
        && request.resource.metadata.ownerType == "meeting-document"
        && request.resource.metadata.ownerId == meetingId
        && request.resource.metadata.section == section
        && request.resource.metadata.uploadedBy == request.auth.uid;
    }

    match /attachments/finance-receipts/{section}/{allPaths=**} { allow list: if canAccessFinanceSection(section); }
    match /attachments/finance-receipts/{section}/{attachmentId}/{fileName} {
      allow get: if canAccessFinanceSection(section);
      allow create: if validReceiptWrite(section);
      allow update: if false;
      allow delete: if canAccessFinanceSection(section) && resource.metadata.ownerType == "finance-receipt" && resource.metadata.section == section;
    }

    match /attachments/event-gallery/{section} { allow list: if canAccessGallerySection(section); }
    match /attachments/event-gallery/{section}/{eventId} { allow list: if canAccessGallerySection(section) || canParentReadGallery(section, eventId); }
    match /attachments/event-gallery/{section}/{eventId}/{allPaths=**} { allow list: if canAccessGallerySection(section) || canParentReadGallery(section, eventId); }
    match /attachments/event-gallery/{section}/{eventId}/{attachmentId}/{fileName} {
      allow get: if canAccessGallerySection(section) || canParentReadGallery(section, eventId);
      allow create: if validEventGalleryWrite(section, eventId);
      allow update: if false;
      allow delete: if canAccessGallerySection(section) && resource.metadata.ownerType == "event-gallery" && resource.metadata.ownerId == eventId && resource.metadata.section == section;
    }

    match /attachments/policy-documents/current/{audience} { allow list: if false; }
    match /attachments/policy-documents/current/{audience}/{documentId} { allow list: if false; }
    match /attachments/policy-documents/current/{audience}/{documentId}/{versionId} { allow list: if false; }
    match /attachments/policy-documents/current/{audience}/{documentId}/{versionId}/{fileName} {
      allow get: if canReadCurrentPolicy(audience, documentId, versionId)
        && resource.metadata.ownerType == "policy-document"
        && resource.metadata.audience == audience
        && resource.metadata.state == "current";
      allow create: if validPolicyWrite(audience, documentId, versionId);
      allow update: if false;
      allow delete: if canManagePolicies() && resource.metadata.ownerType == "policy-document";
    }
    match /attachments/meeting-documents/{section}/{meetingId}/{attachmentId}/{fileName} {
      allow get: if canAccessMeetingSection(section) && resource.metadata.ownerType == "meeting-document" && resource.metadata.ownerId == meetingId && resource.metadata.section == section;
      allow create: if validMeetingDocumentWrite(section, meetingId);
      allow update: if false;
      allow delete: if canAccessMeetingSection(section) && resource.metadata.ownerType == "meeting-document" && resource.metadata.ownerId == meetingId && resource.metadata.section == section;
    }

    match /{allPaths=**} { allow read, write: if false; }
  }
}
